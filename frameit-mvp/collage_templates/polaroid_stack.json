{
  "$schema": "https://frameit.local/schemas/template/v1.json",
  "id": "polaroid_stack",
  "name": "Polaroid stack",
  "version": "1.0.0",
  "style_tags": ["vintage", "casual", "warm", "wanderlust"],
  "constraints": {
    "min_photos": 2,
    "max_photos": 6,
    "preferred_orientations": ["any"],
    "priority": 80
  },
  "canvas": {
    "width": 1080,
    "height": 1080,
    "aspect_ratio": "1:1"
  },
  "randomness": {
    "seed_strategy": "per_render"
  },
  "background": {
    "type": "solid",
    "color": {
      "value": "#F5F0E8",
      "lightness_jitter": { "$rand_int": [-6, 6] }
    }
  },
  "slot_strategy": {
    "type": "scattered",
    "safe_zone": { "x": 60, "y": 60, "width": 960, "height": 960 },
    "overlap_budget": { "$rand": [0.05, 0.18] },
    "z_order": "random"
  },
  "slot_defaults": {
    "size": { "width": 320, "height": 380 },
    "frame": {
      "type": "polaroid",
      "border_top": 12,
      "border_sides": 12,
      "border_bottom": { "$rand_int": [50, 70] },
      "color": { "$pick": ["#FFFFFF", "#FFF9F2", "#FAFAFA"], "weights": [0.5, 0.3, 0.2] },
      "shadow": {
        "enabled": true,
        "blur": { "$rand_int": [8, 18] },
        "opacity": { "$rand": [0.12, 0.22] }
      }
    },
    "transform": {
      "rotation": { "$normal": { "mean": 0, "std": 7 } }
    },
    "crop": { "mode": "cover", "focal_point": "face" }
  },
  "decorations": [
    {
      "id": "tape_accent",
      "type": "tape",
      "asset": { "$pick": ["tape_clear", "tape_washi_floral"] },
      "probability": 0.65,
      "anchor_strategy": "random_slot_top_edge",
      "transform": {
        "rotation": { "$rand": [-8, 8] },
        "opacity": { "$rand": [0.75, 1.0] }
      }
    }
  ],
  "filters": {
    "global": {
      "preset": { "$pick": ["warm_vintage", "faded_film", "none"], "weights": [0.5, 0.3, 0.2] }
    }
  },
  "grain": { "intensity": 0.025 }
}